# =============================================================================
# THE REAL BUILD RECIPE for this project's environment.
# =============================================================================
# Reconstructed 2026-08-31 from `docker history --no-trunc` of the image the
# working container actually ran on (sha256:66e686816190, tagged
# mamba-mmdet:as-run-2026-08-31). NOT written from memory.
#
# READ THIS BEFORE YOU TRUST IT
#   The original image was NOT built from a Dockerfile end to end. Its top two
#   layers are `/bin/bash` -- meaning `docker commit` of a container somebody
#   worked in by hand. Everything below the marker "MANUAL WORK" is therefore
#   RECONSTRUCTED from evidence (the /opt clones' own git remotes and commits),
#   not copied from a build script that ever existed.
#
#   Concretely: the original Dockerfile clones only vim, spatial_mamba and
#   vssd. The wrappers in mmdet/models/backbones/ hard-code /opt/vmamba,
#   /opt/groupmamba and /opt/efficientvmamba and insert them into sys.path
#   themselves. Those four trees were added by hand afterwards. An image built
#   from the original Dockerfile alone LOOKS correct and cannot instantiate
#   VMamba, GroupMamba or EfficientVMamba.
#
#   This file adds them back, pinned to the commits measured on the machine.
#
# WHAT TO EXPECT
#   This file is the supported way to rebuild the environment (the image the
#   work ran on is not distributed). Last verified 2026-09-02: a clean build
#   on Docker Desktop for Windows finished in about 45 minutes with no GPU
#   visible to the build. The pinned dependencies below may still be
#   withdrawn upstream; the self-tests named below are the acceptance
#   criterion, not the build finishing.
#
#   BUILD:  docker build -f Dockerfile.reconstructed -t mamba-mmdet:rebuilt .
#           (the three kernel builds and the image export dominate)
#   VERIFY: python configs/Custom/utils/handover_selftest.py   # 0 failure(s)
#           python configs/Custom/utils/smoke_build_models.py  # on the GPU
# =============================================================================

# Measured from the layer history: CUDA 12.1.0, cuDNN 8.9.0.131, Ubuntu 22.04,
# and the -devel variant (it carries cuda-cudart-dev, nsight-compute, nvprof).
# Pinned by digest as well as tag: NVIDIA prints a deprecation notice for
# this tag at container start and schedules such tags for deletion. Once
# you have a working image, keep a copy (`docker save mamba-mmdet:rebuilt |
# gzip > mamba-mmdet.tar.gz`) or push it to a registry you control.
FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04@sha256:7d3c22648869d206dc4fdd6a304ffd18309b7adeee1e43a1b53b5f126c44e69b

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda

RUN apt-get update && apt-get install -y \
        git wget curl vim nano ninja-build \
        build-essential python3 python3-pip python3-dev \
        libglib2.0-0 libgl1 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python
RUN python3 -m pip install --upgrade pip setuptools wheel

# Pins that every later pip call must respect, whatever an upstream
# requirements file asks for. Each line answers a failure seen in a rebuild:
#   numpy<2        torch 2.1.0 is compiled against NumPy 1.x. Nothing in the
#                  metadata says so, pip picks NumPy 2, and tensor <-> array
#                  conversion then fails at run time ("_ARRAY_API not found").
#   torch*         keeps a dependency of an upstream requirements file from
#                  replacing the CUDA 12.1 build with a PyPI wheel.
#   timm           Spatial-Mamba and VSSD pin timm 0.4.12; MambaVision and
#                  the MambaOut weights need 1.0.15. Their timm line is
#                  skipped below, and this pin makes any other downgrade
#                  fail the build instead of passing silently.
#   mmengine, transformers
#                  the versions the later steps settle on anyway; pinning
#                  them here avoids an install-then-downgrade cycle.
RUN printf '%s\n' 'numpy<2' 'torch==2.1.0' 'torchvision==0.16.0' \
        'torchaudio==2.1.0' 'timm==1.0.15' 'mmengine==0.10.1' \
        'transformers==4.50.0' > /opt/pip-constraints.txt
ENV PIP_CONSTRAINT=/opt/pip-constraints.txt

# Order matters. torch first: mmcv 2.1.0 is sdist-only on PyPI and COMPILES
# against whatever torch and CUDA are present. Installing them together, or
# mmcv first, produces a build against the wrong ABI that fails at import
# with a message about a missing symbol rather than a wrong order.
RUN pip install torch==2.1.0 torchvision==0.16.0 \
        --index-url https://download.pytorch.org/whl/cu121

# mmcv must see torch while it builds. pip >= 25.3 always builds in an
# isolated environment where torch is absent, and mmcv's setup.py then
# SILENTLY skips its CUDA ops: the install succeeds and every detector
# fails later at `from mmcv.ops import ...`. Prefer OpenMMLab's prebuilt
# wheel for this torch/CUDA pair; fall back to a source build that can see
# the installed torch.
RUN pip install mmcv==2.1.0 \
        -f https://download.openmmlab.com/mmcv/dist/cu121/torch2.1/index.html \
    || pip install --no-build-isolation mmcv==2.1.0

RUN pip install \
        mmengine==0.10.1 \
        mmdet==3.3.0 \
        mmsegmentation==1.0.0 \
        mmpretrain==1.2.0

RUN pip install packaging

# From git at a tag, NOT from PyPI -- both compile CUDA extensions, and
# --no-build-isolation is required so they build against the torch installed
# above rather than a fresh one pulled into an isolated build env.
RUN git clone https://github.com/Dao-AILab/causal-conv1d.git /tmp/causal-conv1d \
    && cd /tmp/causal-conv1d && git checkout v1.4.0 \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/causal-conv1d

RUN git clone https://github.com/state-spaces/mamba.git /tmp/mamba \
    && cd /tmp/mamba && git checkout v2.2.4 \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/mamba

RUN pip install mambavision

# ---- trees the original Dockerfile cloned, now pinned -----------------------
# The original used a bare `git clone`, which takes whatever HEAD is on the
# day. Pinned here to the commits measured in the running container, because
# an unpinned clone is a build that quietly stops reproducing itself.
# Their requirements files are installed minus the timm line; see the
# constraints above.
RUN git clone https://github.com/hustvl/Vim.git /opt/vim \
    && git -C /opt/vim checkout dd0358ad1e42701f22afbefa0717cc8825cf9f45

RUN git clone https://github.com/EdwardChasel/Spatial-Mamba.git /opt/spatial_mamba \
    && git -C /opt/spatial_mamba checkout f72ed9b2486a5931190912dcfa8b964033c80e8c \
    && if [ -f /opt/spatial_mamba/requirements.txt ]; then \
           grep -viE '^\s*timm\b' /opt/spatial_mamba/requirements.txt \
               > /tmp/req.txt && pip install -r /tmp/req.txt; fi

RUN git clone https://github.com/YuHengsss/VSSD.git /opt/vssd \
    && git -C /opt/vssd checkout c10de2f8b717a04459b09cbd651de2e768f302c8 \
    && if [ -f /opt/vssd/requirements.txt ]; then \
           grep -viE '^\s*timm\b' /opt/vssd/requirements.txt \
               > /tmp/req.txt && pip install -r /tmp/req.txt; fi

# =============================================================================
# MANUAL WORK -- reconstructed, not from any build script
# =============================================================================
# These trees are absent from the original Dockerfile and were added by hand.
# The backbone wrappers hard-code these exact paths, so the DIRECTORY NAMES
# are load-bearing: /opt/vmamba, /opt/groupmamba, /opt/efficientvmamba.
RUN git clone https://github.com/MzeroMiko/VMamba.git /opt/vmamba \
    && git -C /opt/vmamba checkout 2ed52ead062a51a64521ed3871d52914bf532876

RUN git clone https://github.com/Amshaker/GroupMamba.git /opt/groupmamba \
    && git -C /opt/groupmamba checkout c1800ed262e995de3c645348e7e0202e8385f334

RUN git clone https://github.com/TerryPei/EfficientVMamba.git /opt/efficientvmamba \
    && git -C /opt/efficientvmamba checkout 0bc5ee288b402d648641f5494b73e9d152e0c62b

RUN git clone https://github.com/YuHengsss/MSVMamba.git /opt/msvmamba \
    && git -C /opt/msvmamba checkout c39401918e94f11eb29e4932b901b3fd139f1377

# ---- COMPILED KERNELS -------------------------------------------------------
# The working environment imports selective_scan_cuda, selective_scan_cuda_core,
# selective_scan_cuda_oflex, selective_scan_cuda_ndstate and dwconv2d. Nothing
# above builds them; they were compiled by hand after the image was built.
#
# The setup.py locations are MEASURED on the machine (2026-08-31):
#     /opt/vmamba/kernels/selective_scan/setup.py
#     /opt/spatial_mamba/kernels/selective_scan/setup.py
#     /opt/spatial_mamba/kernels/dwconv2d/setup.py
#     /opt/groupmamba/kernels/selective_scan/setup.py
#     /opt/msvmamba/kernels/selective_scan/setup.py
# (/opt/vmamba/analyze/convnexts4nd/extensions/kernels is unrelated -- an
#  analysis extra, not loaded by any backbone here.)
#
# The INVOCATION below is each repository's documented form. It was not
# captured from the original session, so treat it as unverified until the
# self-test passes. That is the acceptance test, not the build succeeding:
# a build for the wrong architecture succeeds and then fails at run time as
# "no kernel image is available for execution on the device".
#
# TORCH_CUDA_ARCH_LIST is set WIDER than the original. The shipped dwconv2d
# carries sm_75 alone, which is exactly why the image fails on anything newer
# than a TITAN RTX. Building it once for several generations removes that
# problem permanently, and costs only build time.
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0+PTX"

# No GPU is visible during `docker build`, and VMamba's setup.py asks one
# for its compute capability, then passes `-arch=sm_XX` to nvcc. That call
# fails without a driver, and the flag would make torch ignore
# TORCH_CUDA_ARCH_LIST even with one. Two edits: the capability check is
# disabled, and the -arch line is removed so torch's own -gencode flags
# (from the variable above) apply. The build fails loudly if the upstream
# file has changed and the edit no longer lands.
RUN cd /opt/vmamba/kernels/selective_scan \
    && sed -i \
        -e 's/^    if get_compute_capability() < 80:$/    if False:  # patched: no GPU at build time/' \
        -e '/^    cc_flag.append(f"-arch=sm_{get_compute_capability()}")$/d' \
        setup.py \
    && if sed -n '/^def get_ext/,$p' setup.py | grep -q 'get_compute_capability()'; then \
           echo 'setup.py patch did not apply; upstream file changed' >&2; exit 1; fi \
    && pip install --no-build-isolation .

# dwconv2d uses at::NoGradGuard but includes only <ATen/ATen.h>, which
# stopped pulling in the declaration by torch 2.1. One added include line;
# the build fails loudly if the upstream file changes and it no longer lands.
RUN cd /opt/spatial_mamba/kernels/selective_scan \
    && pip install --no-build-isolation . \
    && cd /opt/spatial_mamba/kernels/dwconv2d \
    && sed -i '0,/^#include <ATen\/ATen.h>$/s//#include <ATen\/ATen.h>\n#include <ATen\/core\/grad_mode.h>/' \
        depthwise_fwd/launch.cu \
    && if ! grep -q 'ATen/core/grad_mode.h' depthwise_fwd/launch.cu; then \
           echo 'launch.cu patch did not apply; upstream file changed' >&2; exit 1; fi \
    && pip install --no-build-isolation .

# groupmamba and msvmamba ship their own selective_scan. Whether the project
# needs them separately, or whether the vmamba build satisfies the imports,
# was not established -- build them if the self-test reports a missing
# extension, and not otherwise.
# RUN cd /opt/groupmamba/kernels/selective_scan && pip install --no-build-isolation .
# RUN cd /opt/msvmamba/kernels/selective_scan  && pip install --no-build-isolation .

# One package was pip-installed into the running container after the image was
# built, found by `docker diff`. It is the only genuine drift in six days.
RUN pip install ptflops==0.7.5

# The geospatial stack that palm_inference/ and the evaluation scripts
# import at module scope. The self-test checks for these three by name; a
# first rebuild without them passed every other check and failed there. Placed after the kernel builds so adding it did not
# invalidate their cached layers.
RUN pip install rasterio==1.4.4 geopandas==1.1.3 pyproj

# Fail here, not at first use, if a later step undid one of the pins above.
RUN python -c "import numpy, torch, timm; torch.zeros(1).numpy(); \
    assert numpy.__version__.startswith('1.'), numpy.__version__; \
    assert timm.__version__ == '1.0.15', timm.__version__; \
    print('numpy', numpy.__version__, 'torch', torch.__version__, 'timm', timm.__version__)"

# ---- THIS REPOSITORY --------------------------------------------------------
# The build context is the repository root (`docker build ... .`), so the
# image carries the checkout you build from, local edits included; see
# .dockerignore for what is left out.
#
# The configs import the backbone wrappers as mmdet.models.backbones.*, which
# requires the wrapper modules to live INSIDE the installed mmdet package.
# The original environment ran mmdet from a full source checkout that carried
# them; the pip install above does not. install_backbones.py copies them in.
COPY . /workspace/Datepalm-Instance-Segmentation
RUN python /workspace/Datepalm-Instance-Segmentation/tools/install_backbones.py

# Some configs name their ImageNet weights by the original absolute path
# /workspace/mmdetection/checkpoints/...; others use the relative
# checkpoints/. One mount at the repository's checkpoints/ serves both.
RUN mkdir -p /workspace/mmdetection /workspace/Datepalm-Instance-Segmentation/checkpoints \
    && ln -s /workspace/Datepalm-Instance-Segmentation/checkpoints \
             /workspace/mmdetection/checkpoints

# The experiment 3 dataset file names the COCO trees under /root/datasets/,
# every other dataset file under /workspace/datasets/. One mount serves both.
RUN mkdir -p /workspace/datasets && ln -s /workspace/datasets /root/datasets

# PYTHONPATH carries only three of the seven /opt trees. That is correct and not an
# oversight: the wrappers for vmamba, groupmamba and efficientvmamba insert
# their own paths at import time. Do not "fix" it by adding them -- vmamba and
# groupmamba both ship a module named csms6s.py, and putting both on
# PYTHONPATH makes which one wins depend on import order.
# The repository root is on PYTHONPATH because the configs import their
# shared hooks and samplers as `configs.Custom._base_palm.*`; mmengine adds
# nothing to sys.path, and tools/train.py puts tools/, not the root, first.
ENV PYTHONPATH=/workspace/Datepalm-Instance-Segmentation:/opt/vim:/opt/spatial_mamba:/opt/vssd

WORKDIR /workspace/Datepalm-Instance-Segmentation
CMD ["/bin/bash"]

# RUNNING THE CONTAINER
#   docker run --gpus all -it --shm-size=16g \
#       -v /path/to/datasets:/workspace/datasets \
#       -v /path/to/checkpoints:/workspace/Datepalm-Instance-Segmentation/checkpoints \
#       -v /path/to/work_dirs:/workspace/Datepalm-Instance-Segmentation/work_dirs \
#       mamba-mmdet:rebuilt
#   The dataset configs expect COCO trees under /workspace/datasets/COCO/
#   (see configs/Custom/_base_palm/) -- mount your data there or edit
#   data_root. --shm-size matters: the default 64 MB starves the dataloader
#   workers.
