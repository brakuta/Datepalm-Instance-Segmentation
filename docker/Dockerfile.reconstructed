#       -v /path/to/datasets:/workspace/datasets \
#       -v /path/to/checkpoints:/workspace/mmdetection/checkpoints \
#       mamba-mmdet:rebuilt
#   The dataset configs expect COCO trees under /workspace/datasets/COCO/
#   (see configs/Custom/_base_palm/) -- mount your data there or edit
#   data_root. --shm-size matters: the default 64 MB starves the dataloader
#   workers.
